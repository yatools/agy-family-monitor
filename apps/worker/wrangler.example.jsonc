{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agy-family-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *", "2-59/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agy-family-monitor",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUD",
  },
  "routes": [
    { "pattern": "monitor.example.com", "custom_domain": true },
    { "pattern": "agent-monitor.example.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
